package proofofwork

import (
	"github.com/TecharoHQ/anubis"
	"github.com/TecharoHQ/anubis/lib/challenge/challengepage"
	"github.com/TecharoHQ/anubis/lib/localization"
)

templ page(localizer *localization.SimpleLocalizer) {
	<div class="centered-div challenge-content">
		<img id="image" alt="Anubis · CELPHASE" style="width:100%;max-width:256px;" src={ anubis.BasePrefix + "/.within.website/x/cmd/anubis/static/img/pensive.webp?cacheBuster=" + anubis.Version }/>
		<img alt="" style="display:none;width:100%;max-width:256px;" src={ anubis.BasePrefix + "/.within.website/x/cmd/anubis/static/img/happy.webp?cacheBuster=" + anubis.Version }/>
		<p id="status" aria-live="polite" aria-atomic="true">{ localizer.T("loading") }</p>
		<p id="anubis-script-error" aria-live="polite" style="display:none;">{ localizer.T("script_load_error") }</p>
		<script id="anubis-main" defer type="module" src={ anubis.BasePrefix + "/.within.website/x/cmd/anubis/static/js/main.mjs?cacheBuster=" + anubis.Version }></script>
		@challengepage.Bootstrap()
		<button id="progress" type="button" role="progressbar" tabindex="-1" aria-labelledby="status" aria-valuemin="0" aria-valuemax="100">
			<span class="bar-inner" aria-hidden="true"></span>
		</button>
		@challengepage.Explanation(localizer)
		<noscript>
			<p>
				{ localizer.T("javascript_required") }
			</p>
		</noscript>
		<div id="testarea"></div>
	</div>
}
